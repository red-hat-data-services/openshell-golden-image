### SAW disk-image container
#
# Wraps the qcow2 produced by bootc-image-builder (bib-saw.yaml) as an OCI
# artifact layer. This container is the released artifact: it survives
# internal-registry mirroring and is imported into the openshell-gateway
# DataSource by CDI.
#
# The build is hermetic (RHAI-15894): the qcow2 artifacts are pulled by the
# pre-fetch-disk-image task of pipelines/disk-image-container-hermetic.yaml
# before the build, and land in the build context under disk-image/<arch>.
# Each platform leg copies only its own architecture's disk image.
#
# Build pattern reference: redhat/rhel-ai/containers/bootc
# (Containerfile.bootc-cuda-disk-image-container). Tracking: RHAI-10799.

FROM scratch

ARG SAW_VERSION_ID
ARG TARGETARCH

# The bootc-version label ties the disk image to the bootc source container
# it was built from (lockstep versioning) — what makes the disk
# reproducible and keeps bootc upgrade open as an update path.
LABEL version="${SAW_VERSION_ID}" \
      io.openshell.saw.bootc-version="${SAW_VERSION_ID}"

COPY --chown=107:107 --chmod=0440 disk-image/${TARGETARCH} /disk
