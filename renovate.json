{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>konflux-ci/mintmaker-presets:refresh-rpm-lockfiles"
  ],
  "packageRules": [
    {
      "description": "Refresh rpms.lock.yaml when the base image in argfile-saw.conf changes. The refresh-rpm-lockfiles preset only triggers for the dockerfile manager. The BASE_IMAGE value lives in an external argfile, so the custom.regex manager detects it instead.",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["argfile-saw.conf"],
      "postUpgradeTasks": {
        "commands": [
          "refresh-rpm-lockfiles -f \"$RENOVATE_POST_UPGRADE_COMMAND_DATA_FILE\""
        ],
        "fileFilters": ["**/rpms.lock.yaml"],
        "executionMode": "branch",
        "dataFileTemplate": "[{{#each upgrades}}{\"packageFile\": \"{{{packageFile}}}\"}{{#unless @last}},{{/unless}}{{/each}}]"
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "argfile*.conf"
      ],
      "matchStrings": [
        "BASE_IMAGE=(?<depName>.*):(?<currentValue>.*)"
      ],
      "depNameTemplate": "{{depName}}",
      "datasourceTemplate": "docker",
      "versioningTemplate": "redhat"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "bib-*.yaml"
      ],
      "matchStrings": [
        "bootc-builder-image:\\s*\"(?<depName>[^:@]+):(?<currentValue>[^@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "argfile-saw-disk-image*.conf"
      ],
      "matchStrings": [
        "OCI_EXTRACT_IMAGE=(?<depName>.*):(?<currentValue>.*)"
      ],
      "depNameTemplate": "{{depName}}",
      "datasourceTemplate": "docker",
      "versioningTemplate": "redhat"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "argfile-saw-disk-image*.conf"
      ],
      "matchStrings": [
        "ORAS_VERSION=(?<currentValue>.*)"
      ],
      "depNameTemplate": "oras-project/oras",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
